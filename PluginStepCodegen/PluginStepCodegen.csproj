<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>PluginStepCodegen</AssemblyName>
    <RootNamespace>PluginStepCodegen</RootNamespace>
    <Version>1.2.1-dev</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <Company>Comentality</Company>
    <Authors>Comentality</Authors>
    <Description>Document your registered plugin steps in your existing C# code, as Xrm Tools attributes or a summary comment. Reads the steps and images registered in a Dataverse environment and writes them into the plugin classes they run, so registration shows up in code review, diffs and git history.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NuspecFile>PluginStepCodegen.nuspec</NuspecFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.7.71">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth: the same file the tool writes into user projects. -->
    <EmbeddedResource Include="..\assets\XrmToolsMetaAttributes.cs">
      <LogicalName>PluginStepCodegen.XrmToolsMetaAttributes.cs</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
